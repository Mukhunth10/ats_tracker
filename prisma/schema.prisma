// Portable schema: avoids enums and array columns so the same models run on
// SQLite locally and Postgres in production. Swap `provider` to "postgresql"
// and point DATABASE_URL at the managed instance — no model changes needed.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 takes the connection URL from prisma.config.ts (for migrations) and
// from the driver adapter passed to PrismaClient (at runtime) — not from here.
datasource db {
  provider = "sqlite"
}

model Job {
  id        String   @id @default(cuid())
  title     String
  // BIM discipline focus, e.g. "Revit API", "Dynamo/Python", "IFC/openBIM"
  track     String
  location  String
  seniority String // junior | mid | senior | lead
  // JSON array of keys from the built-in skill library
  mustHave  String   @default("[]")
  niceToHave String  @default("[]")
  // JSON array of raw keyword strings a recruiter typed for this role, e.g.
  // ["Primavera P6 | P6", "quantity takeoff"]. Lets the tool cover any
  // construction discipline without a code change.
  customMustHave   String @default("[]")
  customNiceToHave String @default("[]")
  minYears  Int      @default(0)
  status    String   @default("open") // open | paused | closed
  description String  @default("")
  createdAt DateTime @default(now())

  applications Application[]
}

model Candidate {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  location  String?
  // Raw extracted resume text — kept so a job can be re-scored without re-upload
  resumeText String  @default("")
  resumeFile String? // original filename
  createdAt DateTime @default(now())

  applications Application[]
}

model Application {
  id          String   @id @default(cuid())
  jobId       String
  candidateId String

  // Pipeline position
  stage       String   @default("applied") // applied | screening | interview | offer | hired | rejected

  // Where the application came from: LinkedIn, Indeed, jobs.ie, careers page,
  // referral, agency. Free text so a new portal never needs a schema change.
  source      String   @default("direct")

  // Rules-based score (0-100), always computed
  ruleScore   Int      @default(0)
  // JSON: { matched: string[], missing: string[], yearsDetected: number }
  ruleDetail  String   @default("{}")

  // Claude score (0-100), null until AI screening runs
  aiScore     Int?
  aiSummary   String?
  // JSON: { strengths: string[], gaps: string[], bimEvidence: {skill, evidence}[], recommendation }
  aiDetail    String?
  aiScoredAt  DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  notes     Note[]

  @@unique([jobId, candidateId])
  @@index([jobId, stage])
}

model Note {
  id            String   @id @default(cuid())
  applicationId String
  author        String   @default("recruiter")
  body          String
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}
